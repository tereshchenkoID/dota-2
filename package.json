{
  "name": "dota-spins",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "next start --hostname 127.0.0.1 --port 4173",
    "lint": "npm run lint:js && npm run lint:styles",
    "lint:js": "eslint .",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.scss\" --fix",
    "simulate:arcade": "node --import ./scripts/register-alias.js ./scripts/simulate-arcade.js",
    "simulate:impact": "node --import ./scripts/register-alias.js ./scripts/arcade-impact.js",
    "simulate:builds": "node --import ./scripts/register-alias.js ./scripts/build-benchmark.js",
    "simulate:progression": "node --import ./scripts/register-alias.js ./scripts/build-progression.js",
    "report:builds": "node ./scripts/report-build-analysis.js"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "next": "^16.0.0",
    "next-intl": "^4.14.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/stylelint-plugin": "^5.3.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.0.0",
    "sass": "^1.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.2"
  }
}
